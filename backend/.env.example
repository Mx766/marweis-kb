# ── App ─────────────────────────────────────────────────
ENVIRONMENT=development

# ── Database ───────────────────────────────────────────
DB_USER=marweis
DB_PASSWORD=marweis_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marweis_kb
# DATABASE_URL is auto-built from the above — you can override it:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-random-string
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_HOURS=8

# ── Meilisearch ────────────────────────────────────────
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=marweis_dev_key

# ── MinIO ──────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
# MINIO_PUBLIC_ENDPOINT=minio.example.com:9000  # 公网访问地址，留空则等于 MINIO_ENDPOINT
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=marweis-documents
# MINIO_SECURE=false
# MINIO_PRESIGNED_EXPIRES=3600

# ── Gotenberg ──────────────────────────────────────────
GOTENBERG_URL=http://localhost:3000

# ── OnlyOffice Document Server ─────────────────────────
# ONLYOFFICE_URL=https://office.example.com/onlyoffice
# ONLYOFFICE_JWT_SECRET=change-me  # 必须与 OnlyOffice 容器 JWT_SECRET 一致

# ── AI access ──────────────────────────────────────────
# AI_API_KEY=change-me  # AI 系统调用 /api/ai/* 时使用的 X-AI-Key
